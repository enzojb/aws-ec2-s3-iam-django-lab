{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListImagesPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "images/",
            "images/*"
          ]
        }
      }
    },
    {
      "Sid": "ImagesObjectRW",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::BUCKET_NAME/images/*"
    }
  ]
}
